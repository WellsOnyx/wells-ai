# Wells AI Credit Underwriting - Environment Variables
# Copy to .env.local and fill in your credentials

# =============================================================================
# PLAID - Banking Data Integration
# =============================================================================
# Sign up: https://dashboard.plaid.com/signup
# Documentation: https://plaid.com/docs/

PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# Options: sandbox, development, production

# Products required: Transactions, Auth, Balance
# Webhook URL: https://your-domain.com/api/webhooks/plaid

# =============================================================================
# CODAT - Accounting Data Integration (Optional but Recommended)
# =============================================================================
# Sign up: https://signup.codat.io/
# Documentation: https://docs.codat.io/

CODAT_API_KEY=your_codat_api_key_here

# Enabled integrations:
# - QuickBooks Online
# - Xero
# - FreshBooks
# - Wave
# - Sage

# =============================================================================
# DATABASE (Already Configured)
# =============================================================================
POSTGRES_URL=your_existing_postgres_url

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://wells.ai

# =============================================================================
# CREDIT CONFIGURATION (Optional - Defaults Provided)
# =============================================================================

# Minimum credit score for approval (default: 400)
CREDIT_MIN_SCORE=400

# Maximum credit limit per tier (USD)
CREDIT_LIMIT_PRIME=500000
CREDIT_LIMIT_NEAR_PRIME=250000
CREDIT_LIMIT_SUBPRIME=100000

# APR ranges by tier (%)
CREDIT_APR_PRIME_MIN=6.99
CREDIT_APR_PRIME_MAX=8.99
CREDIT_APR_NEAR_PRIME_MIN=8.99
CREDIT_APR_NEAR_PRIME_MAX=11.99
CREDIT_APR_SUBPRIME_MIN=11.99
CREDIT_APR_SUBPRIME_MAX=18.99

# Payment intercept settings
CREDIT_INTERCEPT_DEFAULT_PERCENTAGE=10
CREDIT_INTERCEPT_MIN_AMOUNT=50
CREDIT_INTERCEPT_MAX_AMOUNT=10000

# Risk management
CREDIT_MAX_UTILIZATION=90
CREDIT_AUTO_REVIEW_DAYS=90
CREDIT_DELINQUENCY_GRACE_DAYS=5

# =============================================================================
# TESTING (Plaid Sandbox)
# =============================================================================
# Plaid Sandbox Test Accounts:
# - Username: user_good, Password: pass_good, MFA: 1234
#   (Strong financials, high credit score)
# - Username: user_custom, Password: pass_good, MFA: 1234
#   (Customizable data for testing edge cases)
