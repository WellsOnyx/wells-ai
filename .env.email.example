# ==========================================
# EMAIL DELIVERY CONFIGURATION
# ==========================================

# Gmail OAuth (for 1:1 high-value outreach)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Instantly API (for automated sequences)
# Get from: https://instantly.ai/settings/api
INSTANTLY_API_KEY=inst_your_api_key_here

# Encryption Master Secret (for secure credential storage)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_SECRET=your_32_character_random_secret_here

# Resend (existing - keep these)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=wells@grainandvault.com

# ==========================================
# PRODUCTION URLS
# ==========================================

# Update these for production deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://wellsai.vercel.app (production)

# ==========================================
# NOTES
# ==========================================

# Gmail OAuth Setup:
# 1. Create project in Google Cloud Console
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URIs:
#    - http://localhost:3000/api/auth/gmail/callback (dev)
#    - https://wellsai.vercel.app/api/auth/gmail/callback (prod)
# 5. Copy Client ID and Client Secret above

# Instantly Setup:
# 1. Sign up at https://instantly.ai
# 2. Go to Settings > API
# 3. Generate API key
# 4. Copy key above

# Security:
# - Never commit .env files to git
# - Use different secrets for dev/staging/prod
# - Rotate API keys regularly
# - Enable 2FA on all accounts
