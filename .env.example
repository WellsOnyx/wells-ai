# Wells Onyx Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================================
# DATABASE (Required)
# ============================================================================
POSTGRES_URL=postgresql://username:password@host:5432/database
# Or use Vercel Postgres:
# POSTGRES_URL=postgres://default:xxx@xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb

# ============================================================================
# AUTHENTICATION (Required - Clerk)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ============================================================================
# AI (Required - Anthropic Claude)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxx

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================

# Slack - For lead notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email - For lead notifications (choose one)
RESEND_API_KEY=re_xxx
# OR
SENDGRID_API_KEY=SG.xxx

# ============================================================================
# APP (Optional)
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: https://wellsonyx.com

# ============================================================================
# LEAD CAPTURE SYSTEM
# ============================================================================
# The following are used by the GTM lead capture system:
# - POSTGRES_URL (required) - stores leads, notes, activities
# - SLACK_WEBHOOK_URL (optional) - sends notifications when leads are captured
# - ANTHROPIC_API_KEY (required) - powers the chat that captures leads
#
# Setup: bash scripts/setup-lead-capture.sh
# Docs: LEAD_CAPTURE_SYSTEM.md
