# NextAuth Authentication (Passwordless Email)
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl

# Email Provider for Magic Links
# You can use Gmail, SendGrid, or any SMTP provider
# Gmail example:
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-api03-...

# Twilio SMS (Optional - for supplier notifications)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Notion Integration (Optional - for CRM)
NOTION_API_KEY=secret_...
NOTION_DEALS_DATABASE_ID=...
NOTION_SUPPLIERS_DB_ID=...
NOTION_REQUESTS_DB_ID=...
NOTION_CRM_DATABASE_ID=...
NOTION_INTERACTIONS_DATABASE_ID=...
NOTION_DOCS_PAGE_ID=...
NOTION_WAITLIST_DATABASE_ID=...  # For viral waitlist (/early-access)

# Instantly.ai Email (Optional - for email campaigns)
INSTANTLY_API_KEY=...
INSTANTLY_DEFAULT_CAMPAIGN_ID=...

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cron Jobs (Optional - for scheduled tasks like digest notifications)
CRON_SECRET=your-secret-here-generate-with-openssl

# Pinecone Vector DB (Optional - for semantic search)
PINECONE_API_KEY=...
PINECONE_INDEX=...

# Database - Postgres (Vercel Postgres or Supabase)
# Vercel: https://vercel.com/dashboard/stores
# Supabase: https://app.supabase.com
DATABASE_URL=postgresql://user:password@host:5432/database

# Airwallex Payments (Primary payment provider)
# Get your credentials at https://www.airwallex.com/app/settings/api
# Lower fees than Stripe: 2.8% domestic, 4.3% international
AIRWALLEX_CLIENT_ID=...
AIRWALLEX_API_KEY=...
AIRWALLEX_ACCOUNT_ID=...
AIRWALLEX_API_URL=https://api.airwallex.com

# Stripe Payments & Connect (Legacy - migrating to Airwallex)
# Get your keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# For webhooks (get from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Merge.dev Universal API (ERP, ATS, HRIS integrations)
# Get your API key at https://app.merge.dev/keys
# Works for both accounting/ERP AND ats/hris categories
MERGE_API_KEY=...

# Shopify Partner API
# Get your Partner API credentials at https://partners.shopify.com
# Earn 20% recurring commission on merchant referrals
# 20% of Shopify Plus monthly fees for enterprise referrals
SHOPIFY_PARTNER_API_KEY=prtapi_...
SHOPIFY_PARTNER_ID=...

# Circle API for Payment Processing
CIRCLE_API_KEY=TEST_API_KEY:36cb901caf0ba554accf785cf6696e4a:a7ae0b280a138a6dfa83c1bca7aa5cc4

# Grain & Vault Pricing System
# Wallet addresses for fee distribution
ADULLAM_WALLET_ADDRESS=0x...  # Base L2 wallet for 10% tithe
WELLS_TREASURY_WALLET=0x...    # Base L2 wallet for Wells net fees
GRAIN_VAULT_ADDRESS=0x...      # Grain Vault smart contract address
GRAIN_TOKEN_ADDRESS=0x...      # GRAIN ERC-20 token address on Base L2

# Feature Flags for Grain & Vault
GRAIN_ENABLED=false            # Enable GRAIN payments (when contracts audited)
CREDIT_LINES_ENABLED=false     # Enable credit lines (when underwriting ready)
TREASURY_YIELD_ENABLED=false   # Enable treasury yield (when strategies ready)
IN_NETWORK_ENABLED=false       # Enable in-network pricing (when wallets rolled out)
