# Wells AI - Environment Variables
# Copy this file to .env.local and fill in your actual credentials

# ===== IBM PARTNERWORLD =====
IBM_CLIENT_ID=your_ibm_client_id_here
IBM_CLIENT_SECRET=your_ibm_client_secret_here

# ===== CISCO PARTNER HUB =====
CISCO_CLIENT_ID=your_cisco_client_id_here
CISCO_CLIENT_SECRET=your_cisco_client_secret_here

# ===== AWS PARTNER NETWORK =====
AWS_PARTNER_API_KEY=your_aws_api_key_here
AWS_PARTNER_CLIENT_ID=your_aws_client_id_here
AWS_PARTNER_CLIENT_SECRET=your_aws_client_secret_here

# ===== SALESFORCE PARTNER COMMUNITY =====
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here

# ===== PLAID PARTNER PORTAL =====
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# ===== MICROSOFT PARTNER CENTER =====
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# ===== GOOGLE CLOUD PARTNER =====
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===== ANTHROPIC (Claude AI) =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== TWILIO (SMS) =====
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18327023075
TEST_PHONE_1=your_test_phone_number_here

# ===== SENDGRID (Email) =====
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@wellsonyx.com
FROM_NAME=Wells Onyx

# ===== INSTANTLY (Email Alternative) =====
INSTANTLY_API_KEY=your_instantly_api_key_here
INSTANTLY_CAMPAIGN_ID=your_campaign_id_here

# ===== NOTION (Databases) =====
NOTION_API_KEY=your_notion_api_key_here
NOTION_RFQ_DATABASE_ID=your_notion_rfq_database_id_here
NOTION_AUDIT_ACTIONS_DB=your_notion_audit_actions_database_id_here

# ===== NEXT.JS =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
