# Wells AI Environment Variables
# Copy this file to .env.local for development
# Add these to Vercel project settings for production

# ============================================
# REQUIRED - Core Services
# ============================================

# Anthropic API (Claude AI)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# PostgreSQL Database
POSTGRES_URL=postgresql://user:password@host:5432/database
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/database?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database

# Application URL
NEXT_PUBLIC_BASE_URL=https://wellsai.vercel.app

# ============================================
# OPTIONAL - Bot Integrations
# ============================================

# Slack Bot
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret

# Microsoft Teams Bot
TEAMS_APP_ID=your-microsoft-app-id
TEAMS_APP_PASSWORD=your-app-password

# Discord Bot
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-client-id
DISCORD_PUBLIC_KEY=your-public-key

# Google Chat Bot
GOOGLE_CHAT_PROJECT_ID=your-project-id
GOOGLE_CHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----
GOOGLE_CHAT_CLIENT_EMAIL=bot@project-id.iam.gserviceaccount.com
GOOGLE_CHAT_VERIFICATION_TOKEN=your-verification-token

# ============================================
# OPTIONAL - ERP Integration (Merge.dev)
# ============================================

# Merge.dev API Keys
MERGE_API_KEY=live_your_production_key
MERGE_TEST_API_KEY=test_your_test_key
MERGE_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# OPTIONAL - Communication Services
# ============================================

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15555555555

# Test Phones (for SMS testing - hardcoded real numbers)
TEST_PHONE_1=+15551234567  # Primary test phone (your phone)
TEST_PHONE_2=+15559876543  # Team member 1
TEST_PHONE_3=+15551112233  # Team member 2

# Notion (GTM/HR/Partnerships)
NOTION_API_KEY=secret_your-notion-integration-key
NOTION_DATABASE_ID_GTM=your-gtm-database-id
NOTION_DATABASE_ID_HR=your-hr-database-id
NOTION_DATABASE_ID_PARTNERSHIPS=your-partnerships-database-id

# ============================================
# OPTIONAL - Payment & Monitoring
# ============================================

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_or_live_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================
# OPTIONAL - Real-time & Caching
# ============================================

# Pusher (Real-time negotiation)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=us2
NEXT_PUBLIC_PUSHER_KEY=your-key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Redis (Caching)
REDIS_URL=redis://default:password@host:6379

# Upstash Redis (Alternative)
UPSTASH_REDIS_REST_URL=https://your-redis-url
UPSTASH_REDIS_REST_TOKEN=your-token

# ============================================
# OPTIONAL - Analytics & Monitoring
# ============================================

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# PostHog (Product Analytics)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# OPTIONAL - Development
# ============================================

# Debug Mode
DEBUG=false
MERGE_DEBUG=false
VERBOSE_LOGGING=false

# Cron Secret (for scheduled jobs)
CRON_SECRET=your-random-secret-here

# ============================================
# SETUP INSTRUCTIONS
# ============================================

# 1. Core Setup (Required)
#    - Get Anthropic API key: https://console.anthropic.com
#    - Set up Postgres: Use Vercel Postgres or your own
#    - Set NEXT_PUBLIC_BASE_URL to your deployment URL

# 2. Bot Setup (Optional)
#    See docs/integrations/BOT_CONFIGURATION_GUIDE.md

# 3. ERP Setup (Optional)
#    See docs/integrations/ERP_INTEGRATION_GUIDE.md

# 4. Validate Environment
#    Run: npm run validate:env

# ============================================
# SECURITY NOTES
# ============================================

# - NEVER commit this file with real values to git
# - Use Vercel project settings for production secrets
# - Rotate keys every 90 days
# - Use different keys for development vs production
# - Enable Vercel secret encryption
