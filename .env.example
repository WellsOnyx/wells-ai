# Grain & Vault Pricing System
# Wallet addresses for fee distribution
ADULLAM_WALLET_ADDRESS=0x...  # Base L2 wallet for 10% tithe
WELLS_TREASURY_WALLET=0x...    # Base L2 wallet for Wells net fees
GRAIN_VAULT_ADDRESS=0x...      # Grain Vault smart contract address
GRAIN_TOKEN_ADDRESS=0x...      # GRAIN ERC-20 token address on Base L2

# Feature Flags for Grain & Vault
GRAIN_ENABLED=false            # Enable GRAIN payments (when contracts audited)
CREDIT_LINES_ENABLED=false     # Enable credit lines (when underwriting ready)
TREASURY_YIELD_ENABLED=false   # Enable treasury yield (when strategies ready)
IN_NETWORK_ENABLED=false       # Enable in-network pricing (when wallets rolled out)

# Wells Onyx Deployment Secret (for AI Ops deployment via API)
# Generate a strong secret: openssl rand -base64 32
WELLS_ONYX_DEPLOYMENT_SECRET=your-secret-here

# Calendar Integration - Direct OAuth to Google, Microsoft, Apple
# Replaced Cal.com with direct integrations using OAuth 2.0

# Google Calendar OAuth
# Get credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized redirect URI: https://your-app.com/api/calendar/connect/google
# 3. Enable Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...
GOOGLE_CALENDAR_REDIRECT_URI=https://your-app.com/api/calendar/connect/google

# Microsoft Graph OAuth (Outlook/365)
# Get credentials at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# 1. Register new application
# 2. Add redirect URI: https://your-app.com/api/calendar/connect/microsoft
# 3. Add API permissions: Calendars.ReadWrite, User.Read, offline_access
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...
MICROSOFT_REDIRECT_URI=https://your-app.com/api/calendar/connect/microsoft

# Apple Calendar (Sign in with Apple + CalDAV)
# Get credentials at: https://developer.apple.com/account/resources/identifiers/list/serviceId
# 1. Create Service ID
# 2. Configure Sign in with Apple
# 3. Add return URL: https://your-app.com/api/calendar/connect/apple
# 4. Create private key for JWT signing
APPLE_CLIENT_ID=...  # Your Service ID
APPLE_TEAM_ID=...    # Your Team ID (10 characters)
APPLE_KEY_ID=...     # Your Key ID
APPLE_PRIVATE_KEY=...  # Your private key (ES256) - use \n for newlines
APPLE_REDIRECT_URI=https://your-app.com/api/calendar/connect/apple

# Vercel Blob Storage (for persistent file storage)
# Get your token at: https://vercel.com/dashboard/stores
# Create a Blob store, then copy the BLOB_READ_WRITE_TOKEN
# Free tier: 100GB storage + 100GB bandwidth
# Paid: $0.15/GB storage + $0.10/GB bandwidth
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Email Configuration Encryption
# Used to encrypt user SMTP credentials and API keys in database
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this secret safe - changing it will invalidate all stored email configs
ENCRYPTION_MASTER_SECRET=...

# Resend Email Service
# Primary email provider for Wells AI
# Get your API key at: https://resend.com/api-keys
# Free tier: 3,000 emails/month
# Paid: $20/month for 50,000 emails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=wells@grainandvault.com
RESEND_ACCOUNT_START_DATE=2024-01-01  # For email warmup schedule

# Resend Webhook Secret (for inbound email)
# Get from: https://resend.com/webhooks
# Used to verify webhook signatures from Resend
# Set webhook URL to: https://your-app.vercel.app/api/inbox/webhooks/email
RESEND_WEBHOOK_SECRET=whsec_...
