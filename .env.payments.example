# ============================================================================
# PAYMENT RAILS CONFIGURATION
# ============================================================================
#
# This file contains all environment variables needed for the Wells AI
# payment infrastructure (Circle + Stripe).
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. Never commit .env.local to git
# 4. Use separate keys for development/production
#
# ============================================================================

# ============================================================================
# CIRCLE (USDC PAYMENTS)
# ============================================================================
#
# Circle provides programmable wallets and USDC infrastructure
# Get keys at: https://console.circle.com
#

# Circle API Key
# - Sandbox: Test with fake USDC (start here)
# - Production: Real USDC transfers
CIRCLE_API_KEY=your_circle_api_key_here

# Circle Entity Secret
# - Used to verify webhook signatures
# - Found in Circle Dashboard → Settings → Webhooks
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# Circle Environment
# - sandbox: For development/testing
# - production: For real money
CIRCLE_ENV=sandbox

# ============================================================================
# STRIPE (FIAT PAYMENTS)
# ============================================================================
#
# Stripe handles card payments, ACH, and bank payouts
# Get keys at: https://dashboard.stripe.com/apikeys
#

# Stripe Secret Key
# - Test mode: sk_test_...
# - Live mode: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe Publishable Key
# - Used by frontend for Stripe Elements
# - Test mode: pk_test_...
# - Live mode: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Stripe Webhook Secret
# - Create webhook at: Developers → Webhooks
# - Endpoint: https://your-domain.com/api/webhooks/payments?provider=stripe
# - Events: payment_intent.*, payout.*, account.updated
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# DATABASE (SUPABASE)
# ============================================================================
#
# Supabase provides PostgreSQL database
# Get credentials at: https://app.supabase.com
#

# Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public)
# - Safe to use in frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (secret)
# - DO NOT expose to frontend
# - Used for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection String (optional)
# - Direct PostgreSQL connection if needed
# DATABASE_URL=postgresql://postgres:password@host:5432/database

# ============================================================================
# APPLICATION
# ============================================================================

# Base URL
# - Development: http://localhost:3000
# - Production: https://your-domain.com
# - Used for Stripe redirects and callbacks
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API URL (if different from base)
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: ENHANCED FEATURES
# ============================================================================

# Plaid (for ACH bank linking)
# - Get keys at: https://dashboard.plaid.com
# PLAID_CLIENT_ID=your_plaid_client_id
# PLAID_SECRET=your_plaid_secret
# PLAID_ENV=sandbox

# Sentry (for error tracking)
# - Get DSN at: https://sentry.io
# SENTRY_DSN=your_sentry_dsn
# SENTRY_ENV=development

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Log Level
# - development: verbose logging
# - production: errors only
LOG_LEVEL=development

# Enable webhook logging
WEBHOOK_LOGGING=true

# Enable balance audit logging
BALANCE_AUDIT=true

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Rate Limiting
# - Max API requests per minute per user
RATE_LIMIT_PER_MINUTE=60

# Max Deposit Amount (in cents)
# - Prevent large unauthorized deposits
MAX_DEPOSIT_CENTS=1000000

# Max Withdrawal Amount (in USDC)
# - Prevent large unauthorized withdrawals
MAX_WITHDRAWAL_USDC=10000

# Require 2FA for withdrawals over this amount
WITHDRAWAL_2FA_THRESHOLD=5000

# ============================================================================
# FLOAT TREASURY SETTINGS
# ============================================================================

# Default settlement window (days)
DEFAULT_SETTLEMENT_DAYS=3

# Float deployment threshold (USDC)
# - Deploy to vault when position >= this amount
FLOAT_DEPLOYMENT_THRESHOLD=100

# Vault APY (for testing/simulation)
# - In production, fetched from actual vault
DEFAULT_VAULT_APY=0.05

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================

# Test mode
# - Skip actual API calls in tests
TEST_MODE=false

# Demo user ID
# - Used for examples and testing
DEMO_USER_ID=demo-user

# Bypass auth (development only!)
# - WARNING: Never enable in production
BYPASS_AUTH=false

# ============================================================================
# MONITORING
# ============================================================================

# Datadog (optional)
# DD_API_KEY=your_datadog_api_key

# New Relic (optional)
# NEW_RELIC_LICENSE_KEY=your_new_relic_key

# ============================================================================
# NOTES
# ============================================================================
#
# DEVELOPMENT SETUP:
# 1. Use Circle Sandbox API key
# 2. Use Stripe test mode keys
# 3. Test with fake money before going live
#
# PRODUCTION SETUP:
# 1. Switch to Circle Production API key
# 2. Switch to Stripe live mode keys
# 3. Set up proper webhook endpoints
# 4. Enable rate limiting
# 5. Configure monitoring
# 6. Test thoroughly in staging first
#
# SECURITY CHECKLIST:
# □ All keys are in .env.local (not committed)
# □ Different keys for dev/prod
# □ Webhook secrets configured
# □ HTTPS enabled in production
# □ Rate limiting enabled
# □ Error monitoring configured
# □ Regular security audits scheduled
#
# ============================================================================
