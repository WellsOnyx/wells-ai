# Vercel Blob Storage Configuration
# Required for persistent file storage in Wells AI

# Vercel Blob Read/Write Token
# Get this from: https://vercel.com/dashboard/stores
# Create a new Blob store or use an existing one
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# Optional: Public app URL for download links
NEXT_PUBLIC_APP_URL=https://wellsai.vercel.app
