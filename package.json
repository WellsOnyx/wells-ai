{
  "name": "wells-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "rm -rf .next out node_modules",
    "db:migrate": "node scripts/migrate.js",
    "db:sync": "node scripts/sync-notion-to-postgres.js",
    "db:reset": "node scripts/reset-db.js",
    "db:migrate:phase4": "node scripts/run-phase4-migration.js",
    "test:load": "artillery run scripts/load-test.yml",
    "test:api": "node scripts/test-api.js",
    "test:conversation": "node scripts/test-conversation.js",
    "validate:env": "node scripts/validate-env.js",
    "validate:all": "npm run type-check && npm run lint && npm run validate:env",
    "prepare": "node scripts/validate-env.js",
    "postinstall": "echo 'Run npm run validate:env to check your environment setup'",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@notionhq/client": "^5.3.0",
    "@pinecone-database/pinecone": "^2.2.2",
    "@sentry/nextjs": "^7.99.0",
    "@slack/web-api": "^7.12.0",
    "@upstash/redis": "^1.28.4",
    "@vercel/postgres": "^0.5.1",
    "date-fns": "^3.0.0",
    "ioredis": "^5.3.2",
    "next": "14.0.4",
    "openai": "^4.104.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "stripe": "^19.2.0",
    "twilio": "^5.10.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "artillery": "^2.0.3",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
