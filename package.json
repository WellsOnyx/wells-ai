{
  "name": "wells-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf .next out node_modules/.cache",
    "clean:all": "rm -rf .next out node_modules",
    "db:migrate": "node scripts/migrate.js",
    "db:sync": "node scripts/sync-notion-to-postgres.js",
    "db:reset": "node scripts/reset-db.js",
    "db:migrate:phase4": "node scripts/run-phase4-migration.js",
    "test:load": "artillery run scripts/load-test.yml",
    "test:api": "node scripts/test-api.js",
    "test:conversation": "node scripts/test-conversation.js",
    "test:validation": "npx tsx scripts/test-validation.ts",
    "gen:onepager": "npx tsx scripts/gen-onepager.ts",
    "gen:ibm": "npx tsx scripts/gen-ibm-customer-ops.ts",
    "queue:ibm-emails": "npx tsx scripts/queue-ibm-emails.ts",
    "send:ibm-emails": "npx tsx scripts/send-ibm-emails.ts",
    "send:ibm-instantly": "npx tsx scripts/send-ibm-via-instantly.ts",
    "instantly:campaigns": "npx tsx scripts/list-instantly-campaigns.ts",
    "test:email": "npx tsx scripts/test-email-delivery.ts",
    "validate:env": "node scripts/validate-env.js",
    "validate:all": "npm run type-check && npm run lint && npm run validate:env",
    "prepare": "node scripts/validate-env.js",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@circle-fin/circle-sdk": "^2.9.0",
    "@clerk/nextjs": "^6.14.5",
    "@notionhq/client": "^5.3.0",
    "@pinecone-database/pinecone": "^2.2.2",
    "@prisma/client": "^6.18.0",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nextjs": "^10.22.0",
    "@slack/web-api": "^7.12.0",
    "@tanstack/react-query": "^5.90.10",
    "@types/papaparse": "^5.5.0",
    "@upstash/redis": "^1.28.4",
    "@vercel/blob": "^2.0.0",
    "@vercel/postgres": "^0.5.1",
    "airwallex-payment-elements": "^1.142.1",
    "date-fns": "^3.0.0",
    "framer-motion": "^12.23.24",
    "googleapis": "^144.0.0",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.552.0",
    "next": "^16.0.1",
    "nodemailer": "^7.0.10",
    "openai": "^4.104.0",
    "paapi5-nodejs-sdk": "^1.1.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "plaid": "^29.0.0",
    "prisma": "^6.18.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.10.3",
    "resend": "^6.4.1",
    "twilio": "^5.10.4",
    "uuid": "^9.0.1",
    "viem": "^2.39.3",
    "wagmi": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "artillery": "^2.0.3",
    "autoprefixer": "^10.0.1",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.5",
    "pdfkit": "^0.17.2",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
