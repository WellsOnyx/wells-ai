{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cold-start/check-replies",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/erp-sync",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://grainandvault.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.grainandvault.com"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://wellsonyx.io/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.wellsonyx.io"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/grain-vault",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/signup",
      "destination": "/grain-vault/signup",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/signup/:path*",
      "destination": "/grain-vault/signup/:path*",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/signin",
      "destination": "/grain-vault/signin",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/signin/:path*",
      "destination": "/grain-vault/signin/:path*",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/demo",
      "destination": "/grain-vault/demo",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/onboarding",
      "destination": "/grain-vault/onboarding",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/account",
      "destination": "/grain-vault/account",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/incentives",
      "destination": "/grain-vault/incentives",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/enterprise",
      "destination": "/grain-vault/enterprise",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/referrals",
      "destination": "/grain-vault/referrals",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/_next/:path*",
      "destination": "/_next/:path*",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    }
  ]
}
