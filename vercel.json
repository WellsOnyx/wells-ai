{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cold-start/check-replies",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://grainandvault.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.grainandvault.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/grain-vault",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "/grain-vault/:path*",
      "has": [
        {
          "type": "host",
          "value": "grainandvault.com"
        }
      ]
    }
  ]
}
