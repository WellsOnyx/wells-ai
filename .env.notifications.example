# ============================================================================
# NOTIFICATION SYSTEM ENVIRONMENT VARIABLES
# ============================================================================
# Copy this to your .env.local and fill in your actual values

# ============================================================================
# TWILIO (SMS Notifications)
# ============================================================================
# Get these from: https://console.twilio.com/
# 1. Sign up for Twilio account (free trial includes $15 credit)
# 2. Get a phone number
# 3. Copy Account SID and Auth Token from Console

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# RESEND (Email Notifications)
# ============================================================================
# Get these from: https://resend.com/
# 1. Sign up for Resend account (free tier: 100 emails/day)
# 2. Create API key in Dashboard
# 3. (Optional) Verify your domain for production

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL="Wells Onyx <notifications@wellsonyx.io>"

# For testing, you can use Resend's test domain:
# FROM_EMAIL="onboarding@resend.dev"

# ============================================================================
# APPLICATION
# ============================================================================
# Base URL for links in notifications (claim URLs, dashboard links, etc.)

# Development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Production
# NEXT_PUBLIC_BASE_URL=https://wellsonyx.io

# ============================================================================
# OPTIONAL: NOTIFICATION SETTINGS
# ============================================================================

# Rate limiting (max notifications per type per hour)
NOTIFICATION_RATE_LIMIT=10

# Default quiet hours (if user hasn't set their own)
DEFAULT_QUIET_HOURS_START=22:00
DEFAULT_QUIET_HOURS_END=08:00
DEFAULT_TIMEZONE=America/New_York

# ============================================================================
# OPTIONAL: WEBHOOK SECURITY
# ============================================================================
# For production, you should verify webhook signatures

# Twilio webhook validation
# TWILIO_WEBHOOK_SECRET=your_webhook_secret

# Resend webhook validation
# RESEND_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# NOTES
# ============================================================================
#
# SMS COSTS (Twilio):
# - US: ~$0.0079 per SMS
# - International: varies by country
# - Free trial: $15 credit
#
# EMAIL COSTS (Resend):
# - Free tier: 100 emails/day (3,000/month)
# - Pro plan: $20/month (50,000 emails)
#
# PRODUCTION CHECKLIST:
# 1. Verify sending domain in Resend
# 2. Set up SPF/DKIM/DMARC records
# 3. Configure webhooks for delivery status
# 4. Test all notification types
# 5. Monitor delivery rates
#
# ============================================================================
