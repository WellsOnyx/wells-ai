generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Transaction {
  id                       String             @id @default(uuid())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  rfqId                    String
  buyerId                  String
  sellerId                 String
  status                   TransactionStatus  @default(DRAFT)
  amount                   Int
  wellsFee                 Int
  wellsFeePercent          Float
  airwallexPaymentIntentId String?
  airwallexClientSecret    String?
  escrowedAt               DateTime?
  releasedAt               DateTime?
  buyerRating              Float?
  sellerRating             Float?
  buyerReview              String?
  sellerReview             String?
  completedAt              DateTime?
  metadata                 Json?
  events                   TransactionEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([rfqId])
}

model TransactionEvent {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  transactionId String
  action        String
  actor         String
  metadata      Json?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([createdAt])
}

model UserTrustScore {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  score             Int      @default(50)
  totalTransactions Int      @default(0)
  completedDeals    Int      @default(0)
  cancelledDeals    Int      @default(0)
  disputedDeals     Int      @default(0)
  averageRating     Float    @default(0)
  totalRatings      Int      @default(0)
  totalGMV          BigInt   @default(0)
  averageDealSize   BigInt   @default(0)
  completionRate    Float    @default(0)
  verificationLevel String   @default("none")

  @@index([userId])
  @@index([score])
}

model RFQ {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  category     String
  title        String
  description  String
  requirements Json?
  status       String        @default("open")
  notionPageId String?
  quotes       SellerQuote[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Conversation {
  id                    String      @id @default(uuid())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  userId                String
  sessionId             String      @unique
  device                String?
  source                String?
  onboardingState       Json?
  onboardingCompleted   Boolean     @default(false)
  onboardingCompletedAt DateTime?
  messageCount          Int         @default(0)
  trustScore            Int         @default(0)
  conversationDepth     Int         @default(0)
  lastActivityAt        DateTime    @default(now())
  lastActivity          String?
  user                  UserContext @relation(fields: [userId], references: [userId])
  messages              Message[]

  @@index([userId])
  @@index([sessionId])
  @@index([lastActivityAt])
}

model Message {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  conversationId String
  role           String
  content        String
  embedding      Json?
  sentiment      String?
  intent         String?
  entities       Json?
  isImportant    Boolean      @default(false)
  importance     Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([isImportant])
}

model UserContext {
  id                 String         @id @default(uuid())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  userId             String         @unique
  name               String?
  preferredName      String?
  email              String?
  phone              String?
  userType           String?
  company            String?
  role               String?
  industry           String?
  goals              Json?
  painPoints         Json?
  preferences        Json?
  totalConversations Int            @default(0)
  totalMessages      Int            @default(0)
  firstSeenAt        DateTime       @default(now())
  lastSeenAt         DateTime       @default(now())
  trustScore         Int            @default(0)
  relationshipDepth  Int            @default(0)
  preferredTimes     Json?
  responseStyle      String?
  conversationPace   String?
  conversations      Conversation[]
  memories           Memory[]

  @@index([userId])
  @@index([userType])
  @@index([lastSeenAt])
}

model Memory {
  id              String      @id @default(uuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String
  category        String
  content         String
  context         String?
  importance      Int         @default(5)
  embedding       Json?
  isVerified      Boolean     @default(false)
  lastUsedAt      DateTime    @default(now())
  sourceMessageId String?
  userContext     UserContext @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([importance])
  @@index([lastUsedAt])
}

model Partner {
  id                     String            @id @default(uuid())
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  name                   String            @unique
  industry               String
  website                String?
  logo                   String?
  primaryContactName     String
  primaryContactEmail    String
  primaryContactTitle    String?
  primaryContactPhone    String?
  partnershipType        String
  signedDate             DateTime?
  contractValue          Int?
  defaultDealSplit       Json
  status                 String            @default("active")
  totalPlaybooks         Int               @default(0)
  totalDeals             Int               @default(0)
  totalRevenue           BigInt            @default(0)
  referralUrl            String?
  referralCategory       String?
  partnerDescription     String?
  commissionRate         Float?
  recommendationTriggers String[]
  playbooks              CoSellPlaybook[]
  referrals              PartnerReferral[]

  @@index([name])
  @@index([status])
  @@index([referralCategory])
}

model CoSellPlaybook {
  id                  String          @id @default(uuid())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  partnerId           String
  partnerContactEmail String
  name                String
  valueProposition    String
  dealSplit           Json
  outreachStrategy    String          @default("email-sequence")
  status              PlaybookStatus  @default(DRAFT)
  createdBy           String
  totalTargets        Int             @default(0)
  contacted           Int             @default(0)
  responded           Int             @default(0)
  meetingsBooked      Int             @default(0)
  dealsWon            Int             @default(0)
  totalRevenue        BigInt          @default(0)
  partner             Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  emailSequence       EmailSequence?
  targetAccounts      TargetAccount[]

  @@index([partnerId])
  @@index([status])
  @@index([createdBy])
}

model TargetAccount {
  id                String         @id @default(uuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  playbookId        String
  companyName       String
  industry          String?
  revenue           String?
  employeeCount     String?
  painPoint         String
  solution          String
  estimatedDealSize Int            @default(500000)
  contactName       String?
  contactEmail      String?
  contactTitle      String?
  contactPhone      String?
  linkedinUrl       String?
  outreachSequence  Json?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  dealStage         DealStage      @default(PROSPECTING)
  dealValue         Int?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  notes             String?
  playbook          CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@index([dealStage])
  @@index([nextFollowUpAt])
}

model EmailSequence {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  playbookId String         @unique
  sequence   Json
  playbook   CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
}

model GrainEscrow {
  id               String       @id @default(uuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  escrowId         String       @unique
  chainId          Int
  contractAddress  String
  transactionHash  String?
  depositor        String
  beneficiary      String
  arbitrator       String?
  totalAmount      BigInt
  releasedAmount   BigInt       @default(0)
  status           EscrowStatus @default(PENDING)
  milestones       Json
  depositedAt      DateTime?
  firstReleaseAt   DateTime?
  completedAt      DateTime?
  disputedAt       DateTime?
  dealId           String?
  dealDescription  String?
  escrowFeePercent Float        @default(0.5)
  escrowFee        BigInt?

  @@index([escrowId])
  @@index([depositor])
  @@index([beneficiary])
  @@index([status])
  @@index([createdAt])
}

model PartnerReferral {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String
  partnerId        String
  referralUrl      String
  context          String
  clickedAt        DateTime?
  convertedAt      DateTime?
  conversionValue  BigInt?
  commissionEarned BigInt?
  status           String    @default("pending")
  partner          Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

model SellerProfile {
  id                      String                        @id @default(uuid())
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  userId                  String                        @unique
  companyName             String
  contactName             String
  email                   String
  phone                   String?
  categories              String[]
  products                String[]
  services                String[]
  minimumOrderQuantity    Int?
  maximumOrderQuantity    Int?
  leadTimeDays            Int?
  shippingRegions         String[]
  yearsInBusiness         Int?
  certifications          String[]
  website                 String?
  pricingModel            PricingModel                  @default(NEGOTIABLE)
  typicalPriceRange       String?
  notificationChannels    String[]
  notificationFrequency   NotificationFrequency         @default(INSTANT)
  verified                Boolean                       @default(false)
  active                  Boolean                       @default(true)
  rating                  Float?
  completedDeals          Int                           @default(0)
  onboardingState         Json?
  onboardingCompleted     Boolean                       @default(false)
  notifications           SellerNotification[]
  notificationPreferences SellerNotificationPreference?
  quotes                  SellerQuote[]

  @@index([userId])
  @@index([active])
  @@index([verified])
  @@index([categories])
}

model SellerQuote {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sellerId       String
  rfqId          String
  pricePerUnit   Int
  totalPrice     Int
  quantity       Int
  leadTimeDays   Int
  validUntil     DateTime
  notes          String?
  terms          String?
  specifications Json?
  status         String        @default("pending")
  acceptedAt     DateTime?
  acceptedBy     String?
  rfq            RFQ           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller         SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([rfqId])
  @@index([status])
  @@index([createdAt])
}

model SellerNotification {
  id               String             @id @default(uuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sellerId         String
  rfqId            String
  notificationType NotificationType   @default(INSTANT)
  matchScore       Int
  matchReasons     String[]
  channels         String[]
  status           NotificationStatus @default(PENDING)
  sentAt           DateTime?
  deliveredAt      DateTime?
  openedAt         DateTime?
  clickedAt        DateTime?
  smsSid           String?
  smsStatus        String?
  emailStatus      String?
  emailId          String?
  responded        Boolean            @default(false)
  respondedAt      DateTime?
  seller           SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([rfqId])
  @@index([status])
  @@index([createdAt])
  @@index([notificationType])
}

model SellerNotificationPreference {
  id                 String        @id @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sellerId           String        @unique
  smsOptedOut        Boolean       @default(false)
  emailOptedOut      Boolean       @default(false)
  optedOutAt         DateTime?
  optOutReason       String?
  enabledCategories  String[]
  disabledCategories String[]
  quietHoursEnabled  Boolean       @default(false)
  quietHoursStart    String?
  quietHoursEnd      String?
  quietHoursTimezone String?
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model WellsOnyxCampaign {
  id                  String         @id @default(uuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  campaignId          String         @unique
  userId              String
  practiceGroupId     String
  practiceGroupName   String
  status              CampaignStatus @default(DRAFT)
  prospectCount       Int            @default(0)
  messageCount        Int            @default(0)
  approvedCount       Int            @default(0)
  sentCount           Int            @default(0)
  practiceGroupData   Json?
  prospectsData       Json?
  messagesData        Json?
  instantlyApiKey     String?
  instantlyCampaignId String?
  approvedAt          DateTime?
  sentAt              DateTime?
  completedAt         DateTime?

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model ai_suggestions {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  room_id           String?            @db.Uuid
  suggestion_type   String             @db.VarChar(50)
  suggestion        String
  context           Json?              @default("{}")
  shown_to          String             @db.VarChar(50)
  was_helpful       Boolean?
  feedback          String?
  created_at        DateTime?          @default(now()) @db.Timestamp(6)
  negotiation_rooms negotiation_rooms? @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_suggestions_created")
  @@index([room_id], map: "idx_suggestions_room")
  @@index([suggestion_type], map: "idx_suggestions_type")
}

model analytics_cache {
  id           Int       @id @default(autoincrement())
  metric_key   String    @unique @db.VarChar(255)
  metric_value Json
  cache_period String?   @db.VarChar(50)
  last_updated DateTime? @default(now()) @db.Timestamp(6)
  expires_at   DateTime? @default(dbgenerated("(now() + '01:00:00'::interval)")) @db.Timestamp(6)

  @@index([expires_at], map: "idx_analytics_expires")
  @@index([metric_key], map: "idx_analytics_key")
}

model analytics_events {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event_type String    @db.VarChar(100)
  event_data Json      @default("{}")
  user_id    String?   @db.VarChar(255)
  session_id String?   @db.VarChar(255)
  timestamp  DateTime? @default(now()) @db.Timestamp(6)

  @@index([session_id], map: "idx_analytics_session")
  @@index([timestamp(sort: Desc)], map: "idx_analytics_timestamp")
  @@index([event_type], map: "idx_analytics_type")
  @@index([user_id], map: "idx_analytics_user")
}

model approval_workflows {
  id               Int       @id @default(autoincrement())
  entity_type      String    @db.VarChar(50)
  entity_id        Int
  approval_level   Int       @default(1)
  approver_id      String    @db.VarChar(255)
  approver_name    String?   @db.VarChar(255)
  approver_email   String?   @db.VarChar(255)
  status           String?   @default("pending") @db.VarChar(50)
  approved_at      DateTime? @db.Timestamp(6)
  rejection_reason String?
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([approver_id, status], map: "idx_approval_approver")
  @@index([entity_type, entity_id], map: "idx_approval_entity")
}

model auto_response_rules {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String    @db.VarChar(255)
  name              String    @db.VarChar(255)
  enabled           Boolean?  @default(true)
  priority          Int?      @default(50)
  channel_filter    String?   @db.VarChar(50)
  sender_filter     String?   @db.VarChar(255)
  intent_filter     String?   @db.VarChar(100)
  urgency_filter    String?   @db.VarChar(20)
  keyword_filters   Json?     @default("[]")
  time_window       Json?
  action_type       String    @db.VarChar(50)
  response_template String?
  forward_to        String?   @db.VarChar(255)
  require_approval  Boolean?  @default(false)
  cooldown_hours    Int?      @default(24)
  metadata          Json?     @default("{}")
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)

  @@index([priority(sort: Desc)], map: "idx_auto_response_rules_priority")
  @@index([user_id], map: "idx_auto_response_rules_user")
}

model budget_plans {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  department       String?   @db.VarChar(100)
  category         String?   @db.VarChar(100)
  fiscal_year      Int
  fiscal_quarter   Int?
  planned_amount   Decimal   @db.Decimal(15, 2)
  actual_amount    Decimal?  @default(0) @db.Decimal(15, 2)
  variance         Decimal?  @default(0) @db.Decimal(15, 2)
  variance_percent Decimal?  @default(0) @db.Decimal(5, 2)
  status           String?   @default("active") @db.VarChar(50)
  owner_id         String?   @db.VarChar(255)
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([category], map: "idx_budget_category")
  @@index([fiscal_year, fiscal_quarter], map: "idx_budget_year")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model calendar_availability_preferences {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
