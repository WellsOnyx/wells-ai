generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  userContext   UserContext?
  userProfile   UserProfile?

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

model Transaction {
  id                       String             @id @default(uuid())
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  rfqId                    String
  buyerId                  String
  sellerId                 String
  status                   TransactionStatus  @default(DRAFT)
  amount                   Int
  wellsFee                 Int
  wellsFeePercent          Float
  airwallexPaymentIntentId String?
  airwallexClientSecret    String?
  escrowedAt               DateTime?
  releasedAt               DateTime?
  buyerRating              Float?
  sellerRating             Float?
  buyerReview              String?
  sellerReview             String?
  completedAt              DateTime?
  metadata                 Json?
  events                   TransactionEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([rfqId])
}

model TransactionEvent {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  transactionId String
  action        String
  actor         String
  metadata      Json?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([createdAt])
}

model UserTrustScore {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  score             Int      @default(50)
  totalTransactions Int      @default(0)
  completedDeals    Int      @default(0)
  cancelledDeals    Int      @default(0)
  disputedDeals     Int      @default(0)
  averageRating     Float    @default(0)
  totalRatings      Int      @default(0)
  totalGMV          BigInt   @default(0)
  averageDealSize   BigInt   @default(0)
  completionRate    Float    @default(0)
  verificationLevel String   @default("none")

  @@index([userId])
  @@index([score])
}

model RFQ {
  id           String        @id @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  category     String
  title        String
  description  String
  requirements Json?
  status       String        @default("open")
  notionPageId String?
  quotes       SellerQuote[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Conversation {
  id                    String       @id @default(uuid())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  userId                String
  sessionId             String       @unique
  device                String?
  source                String?
  activeJourney         String?      // buyer, seller, job_seeker, founder
  onboardingState       Json?
  onboardingCompleted   Boolean      @default(false)
  onboardingCompletedAt DateTime?
  messageCount          Int          @default(0)
  trustScore            Int          @default(0)
  conversationDepth     Int          @default(0)
  lastActivityAt        DateTime     @default(now())
  lastActivity          String?
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              Message[]

  @@index([userId])
  @@index([sessionId])
  @@index([lastActivityAt])
}

model Message {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  conversationId String
  role           String
  content        String
  embedding      Json?
  sentiment      String?
  intent         String?
  entities       Json?
  isImportant    Boolean      @default(false)
  importance     Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([isImportant])
}

model UserContext {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String   @unique
  name               String?
  preferredName      String?
  email              String?
  phone              String?
  userType           String?
  company            String?
  role               String?
  industry           String?
  goals              Json?
  painPoints         Json?
  preferences        Json?
  totalConversations Int      @default(0)
  totalMessages      Int      @default(0)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  trustScore         Int      @default(0)
  relationshipDepth  Int      @default(0)
  preferredTimes     Json?
  responseStyle      String?
  conversationPace   String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories           Memory[]

  @@index([userId])
  @@index([userType])
  @@index([lastSeenAt])
}

model Memory {
  id              String      @id @default(uuid())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  userId          String
  category        String
  content         String
  context         String?
  importance      Int         @default(5)
  embedding       Json?
  isVerified      Boolean     @default(false)
  lastUsedAt      DateTime    @default(now())
  sourceMessageId String?
  userContext     UserContext @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([importance])
  @@index([lastUsedAt])
}

model Partner {
  id                     String            @id @default(uuid())
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  name                   String            @unique
  industry               String
  website                String?
  logo                   String?
  primaryContactName     String
  primaryContactEmail    String
  primaryContactTitle    String?
  primaryContactPhone    String?
  partnershipType        String
  signedDate             DateTime?
  contractValue          Int?
  defaultDealSplit       Json
  status                 String            @default("active")
  totalPlaybooks         Int               @default(0)
  totalDeals             Int               @default(0)
  totalRevenue           BigInt            @default(0)
  referralUrl            String?
  referralCategory       String?
  partnerDescription     String?
  commissionRate         Float?
  recommendationTriggers String[]
  playbooks              CoSellPlaybook[]
  referrals              PartnerReferral[]

  @@index([name])
  @@index([status])
  @@index([referralCategory])
}

model CoSellPlaybook {
  id                  String          @id @default(uuid())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  partnerId           String
  partnerContactEmail String
  name                String
  valueProposition    String
  dealSplit           Json
  outreachStrategy    String          @default("email-sequence")
  status              PlaybookStatus  @default(DRAFT)
  createdBy           String
  totalTargets        Int             @default(0)
  contacted           Int             @default(0)
  responded           Int             @default(0)
  meetingsBooked      Int             @default(0)
  dealsWon            Int             @default(0)
  totalRevenue        BigInt          @default(0)
  partner             Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  emailSequence       EmailSequence?
  targetAccounts      TargetAccount[]

  @@index([partnerId])
  @@index([status])
  @@index([createdBy])
}

model TargetAccount {
  id                String         @id @default(uuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  playbookId        String
  companyName       String
  industry          String?
  revenue           String?
  employeeCount     String?
  painPoint         String
  solution          String
  estimatedDealSize Int            @default(500000)
  contactName       String?
  contactEmail      String?
  contactTitle      String?
  contactPhone      String?
  linkedinUrl       String?
  outreachSequence  Json?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  dealStage         DealStage      @default(PROSPECTING)
  dealValue         Int?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  notes             String?
  playbook          CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@index([dealStage])
  @@index([nextFollowUpAt])
}

model EmailSequence {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  playbookId String         @unique
  sequence   Json
  playbook   CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
}

model GrainEscrow {
  id               String       @id @default(uuid())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  escrowId         String       @unique
  chainId          Int
  contractAddress  String
  transactionHash  String?
  depositor        String
  beneficiary      String
  arbitrator       String?
  totalAmount      BigInt
  releasedAmount   BigInt       @default(0)
  status           EscrowStatus @default(PENDING)
  milestones       Json
  depositedAt      DateTime?
  firstReleaseAt   DateTime?
  completedAt      DateTime?
  disputedAt       DateTime?
  dealId           String?
  dealDescription  String?
  escrowFeePercent Float        @default(0.5)
  escrowFee        BigInt?

  @@index([escrowId])
  @@index([depositor])
  @@index([beneficiary])
  @@index([status])
  @@index([createdAt])
}

model PartnerReferral {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  userId           String
  partnerId        String
  referralUrl      String
  context          String
  clickedAt        DateTime?
  convertedAt      DateTime?
  conversionValue  BigInt?
  commissionEarned BigInt?
  status           String    @default("pending")
  partner          Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

model SellerProfile {
  id                      String                        @id @default(uuid())
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  userId                  String                        @unique
  companyName             String
  contactName             String
  email                   String
  phone                   String?
  categories              String[]
  products                String[]
  services                String[]
  minimumOrderQuantity    Int?
  maximumOrderQuantity    Int?
  leadTimeDays            Int?
  shippingRegions         String[]
  yearsInBusiness         Int?
  certifications          String[]
  website                 String?
  pricingModel            PricingModel                  @default(NEGOTIABLE)
  typicalPriceRange       String?
  notificationChannels    String[]
  notificationFrequency   NotificationFrequency         @default(INSTANT)
  verified                Boolean                       @default(false)
  active                  Boolean                       @default(true)
  rating                  Float?
  completedDeals          Int                           @default(0)
  onboardingState         Json?
  onboardingCompleted     Boolean                       @default(false)
  notifications           SellerNotification[]
  notificationPreferences SellerNotificationPreference?
  quotes                  SellerQuote[]

  @@index([userId])
  @@index([active])
  @@index([verified])
  @@index([categories])
}

model SellerQuote {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sellerId       String
  rfqId          String
  pricePerUnit   Int
  totalPrice     Int
  quantity       Int
  leadTimeDays   Int
  validUntil     DateTime
  notes          String?
  terms          String?
  specifications Json?
  status         String        @default("pending")
  acceptedAt     DateTime?
  acceptedBy     String?
  rfq            RFQ           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  seller         SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([rfqId])
  @@index([status])
  @@index([createdAt])
}

model SellerNotification {
  id               String             @id @default(uuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sellerId         String
  rfqId            String
  notificationType NotificationType   @default(INSTANT)
  matchScore       Int
  matchReasons     String[]
  channels         String[]
  status           NotificationStatus @default(PENDING)
  sentAt           DateTime?
  deliveredAt      DateTime?
  openedAt         DateTime?
  clickedAt        DateTime?
  smsSid           String?
  smsStatus        String?
  emailStatus      String?
  emailId          String?
  responded        Boolean            @default(false)
  respondedAt      DateTime?
  seller           SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([rfqId])
  @@index([status])
  @@index([createdAt])
  @@index([notificationType])
}

model SellerNotificationPreference {
  id                 String        @id @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sellerId           String        @unique
  smsOptedOut        Boolean       @default(false)
  emailOptedOut      Boolean       @default(false)
  optedOutAt         DateTime?
  optOutReason       String?
  enabledCategories  String[]
  disabledCategories String[]
  quietHoursEnabled  Boolean       @default(false)
  quietHoursStart    String?
  quietHoursEnd      String?
  quietHoursTimezone String?
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model WellsOnyxCampaign {
  id                  String         @id @default(uuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  campaignId          String         @unique
  userId              String
  practiceGroupId     String
  practiceGroupName   String
  status              CampaignStatus @default(DRAFT)
  prospectCount       Int            @default(0)
  messageCount        Int            @default(0)
  approvedCount       Int            @default(0)
  sentCount           Int            @default(0)
  practiceGroupData   Json?
  prospectsData       Json?
  messagesData        Json?
  instantlyApiKey     String?
  instantlyCampaignId String?
  approvedAt          DateTime?
  sentAt              DateTime?
  completedAt         DateTime?

  @@index([userId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

enum TransactionStatus {
  DRAFT
  QUOTED
  ACCEPTED
  ESCROWED
  IN_PROGRESS
  COMPLETED
  RELEASED
  DISPUTED
  CANCELLED
}

enum PlaybookStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DealStage {
  PROSPECTING
  QUALIFIED
  DEMO_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum EscrowStatus {
  PENDING
  ACTIVE
  MILESTONE_1
  MILESTONE_2
  COMPLETED
  DISPUTED
  CANCELLED
  EXPIRED
}

enum PricingModel {
  FIXED
  VOLUME_DISCOUNT
  NEGOTIABLE
  RFQ_ONLY
}

enum NotificationFrequency {
  INSTANT
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum NotificationType {
  INSTANT
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum CampaignStatus {
  DRAFT
  READY
  SENDING
  SENT
  COMPLETED
  PAUSED
}


// User profile for Wells onboarding
model UserProfile {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  company          String?
  role             String?
  industry         String?
  goals            String?  @db.Text
  preferredJourney String?  // buyer, seller, job_seeker, founder
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
