// Wells AI Database Schema
// Transaction engine for $7T B2B platform

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NEXTAUTH MODELS
// Authentication system using email magic links
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

// Transaction statuses
enum TransactionStatus {
  DRAFT           // RFQ created, finding matches
  QUOTED          // Suppliers sent quotes
  ACCEPTED        // Buyer accepted, escrow pending
  ESCROWED        // Funds in escrow
  IN_PROGRESS     // Work happening
  COMPLETED       // Work done, awaiting release
  RELEASED        // Funds released, deal complete
  DISPUTED        // Issue raised
  CANCELLED       // Deal cancelled
}

// Main transaction model
model Transaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RFQ reference
  rfqId String

  // Parties
  buyerId  String
  sellerId String

  // Status tracking
  status TransactionStatus @default(DRAFT)

  // Financial (all amounts in cents)
  amount          Int    // Deal value
  wellsFee        Int    // Platform fee
  wellsFeePercent Float  // Fee percentage (e.g., 2.5)

  // Airwallex payment details
  airwallexPaymentIntentId String?
  airwallexClientSecret    String?
  escrowedAt               DateTime?
  releasedAt               DateTime?

  // Trust/ratings (1-5 stars)
  buyerRating  Float?
  sellerRating Float?
  buyerReview  String?
  sellerReview String?

  // Completion tracking
  completedAt DateTime?

  // Audit trail
  events TransactionEvent[]

  // Metadata
  metadata Json? // Flexible field for additional data

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([rfqId])
}

// Transaction event log (audit trail)
model TransactionEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Link to transaction
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Event details
  action   String // e.g., "transaction_created", "payment_escrowed", "funds_released"
  actor    String // "buyer", "seller", or "system"
  metadata Json?  // Additional event data

  @@index([transactionId])
  @@index([createdAt])
}

// User trust scores (for reputation system)
model UserTrustScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User reference
  userId String @unique

  // Trust metrics
  score            Int   @default(50) // 0-100
  totalTransactions Int  @default(0)
  completedDeals   Int   @default(0)
  cancelledDeals   Int   @default(0)
  disputedDeals    Int   @default(0)

  // Rating stats
  averageRating  Float @default(0) // 1-5 stars
  totalRatings   Int   @default(0)

  // Deal value stats (in cents)
  totalGMV       BigInt @default(0)
  averageDealSize BigInt @default(0)

  // Completion rate (percentage)
  completionRate Float @default(0)

  // Verification level
  verificationLevel String @default("none") // "none", "basic", "enhanced", "premium"

  @@index([userId])
  @@index([score])
}

// RFQ (Request for Quote) - minimal model, most data in Notion
model RFQ {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Requester
  userId String

  // Category and details
  category     String
  title        String
  description  String
  requirements Json?

  // Status
  status String @default("open") // "open", "matched", "closed"

  // Notion reference
  notionPageId String?

  // Quotes from sellers
  quotes SellerQuote[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// ============================================
// MEMORY & RELATIONSHIP SYSTEM
// Wells remembers EVERYTHING and builds deep companion relationships
// ============================================

// Conversation session - groups messages together
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User reference
  userId String

  // Session metadata
  sessionId String @unique // Frontend session ID
  device    String? // "web", "mobile", "widget"
  source    String? // "app", "widget", "api"

  // Onboarding state (JSON serialized OnboardingState)
  onboardingState Json?
  onboardingCompleted Boolean @default(false)
  onboardingCompletedAt DateTime?

  // Relationship metrics
  messageCount     Int @default(0)
  trustScore       Int @default(0) // 0-100
  conversationDepth Int @default(0)

  // Last activity
  lastActivityAt DateTime @default(now())
  lastActivity   String? // What Wells was doing/thinking about

  // Messages in this conversation
  messages Message[]

  // Link to user context
  userContext UserContext? @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([sessionId])
  @@index([lastActivityAt])
}

// Individual message with embeddings for semantic search
model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Link to conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Message content
  role    String // "user" or "assistant"
  content String @db.Text

  // Vector embedding for semantic search (stored as JSON array)
  embedding Json? // [0.123, 0.456, ...] - 1536 dimensions for OpenAI embeddings

  // Message metadata
  sentiment String? // "positive", "neutral", "negative", "urgent", "stressed"
  intent    String? // "question", "request", "greeting", "feedback", etc.

  // Extracted entities (names, companies, dates, etc.)
  entities Json? // {"people": ["John"], "companies": ["Acme Corp"], ...}

  // Important message flag (Wells should remember this)
  isImportant Boolean @default(false)
  importance  Int @default(0) // 0-10 importance score

  @@index([conversationId])
  @@index([createdAt])
  @@index([isImportant])
}

// User context - what Wells has learned about the user
model UserContext {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User reference
  userId String @unique

  // Basic info (from onboarding)
  name          String?
  preferredName String?
  email         String?
  phone         String?
  userType      String? // "buyer", "seller", "both", "job_seeker", "founder"

  // Deep context (learned over time)
  company       String?
  role          String?
  industry      String?
  goals         Json? // ["Find better suppliers", "Grow revenue", ...]
  painPoints    Json? // ["High costs", "Slow delivery", ...]
  preferences   Json? // {"communication": "email", "frequency": "daily", ...}

  // Relationship tracking
  totalConversations Int @default(0)
  totalMessages      Int @default(0)
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  // Trust & relationship
  trustScore         Int @default(0) // 0-100
  relationshipDepth  Int @default(0) // How well Wells knows them

  // Behavioral patterns
  preferredTimes     Json? // When they usually chat
  responseStyle      String? // "brief", "detailed", "technical"
  conversationPace   String? // "fast", "normal", "contemplative"

  // Important memories (quick access)
  memories Memory[]

  // Conversations
  conversations Conversation[]

  @@index([userId])
  @@index([userType])
  @@index([lastSeenAt])
}

// Important memories Wells should always remember
model Memory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link to user
  userId      String
  userContext UserContext @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // Memory content
  category    String // "fact", "preference", "goal", "pain_point", "relationship", "event"
  content     String @db.Text
  context     String? @db.Text // Additional context about when/how this was learned

  // Importance (1-10)
  importance  Int @default(5)

  // Embedding for semantic retrieval
  embedding Json?

  // Verification
  isVerified Boolean @default(false) // User confirmed this is accurate
  lastUsedAt DateTime @default(now()) // When Wells last recalled this memory

  // Related message
  sourceMessageId String?

  @@index([userId])
  @@index([category])
  @@index([importance])
  @@index([lastUsedAt])
}

// ============================================
// PARTNER ECOSYSTEM & CO-SELL PLAYBOOKS
// Powers 33-partner network generating $24.75M/year
// ============================================

enum PlaybookStatus {
  DRAFT           // Being created
  ACTIVE          // Live and running outreach
  PAUSED          // Temporarily paused
  COMPLETED       // All targets contacted
  ARCHIVED        // No longer active
}

enum DealStage {
  PROSPECTING     // Initial outreach
  QUALIFIED       // Target expressed interest
  DEMO_SCHEDULED  // Demo booked
  PROPOSAL_SENT   // Proposal delivered
  NEGOTIATION     // In negotiation
  CLOSED_WON      // Deal won!
  CLOSED_LOST     // Deal lost
}

// Strategic partner definition
model Partner {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partner info
  name              String @unique
  industry          String
  website           String?
  logo              String?

  // Contact details
  primaryContactName  String
  primaryContactEmail String
  primaryContactTitle String?
  primaryContactPhone String?

  // Partnership details
  partnershipType   String // "Technology", "Channel", "Reseller", "Referral"
  signedDate        DateTime?
  contractValue     Int? // Annual contract value in cents

  // Deal split (JSON)
  defaultDealSplit  Json // {"wells": 30, "partner": 70}

  // Status
  status            String @default("active") // "active", "inactive", "pending"

  // Relationship metrics
  totalPlaybooks    Int @default(0)
  totalDeals        Int @default(0)
  totalRevenue      BigInt @default(0)

  // Referral tracking (for partner recommendations)
  referralUrl           String? // Tracked referral link with partner ID
  referralCategory      String? // "Payment Processing", "Infrastructure", "SaaS", etc.
  partnerDescription    String? // What the partner offers
  commissionRate        Float? // Percentage (e.g., 0.15 for 15%)
  recommendationTriggers String[] // Keywords for Wells to detect recommendation opportunities

  // Co-sell playbooks
  playbooks CoSellPlaybook[]

  // Referral tracking
  referrals PartnerReferral[]

  @@index([name])
  @@index([status])
  @@index([referralCategory])
}

// Co-sell playbook (campaign for a specific partner)
model CoSellPlaybook {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Partner link
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Partner contact for this playbook
  partnerContactEmail String

  // Playbook details
  name              String
  valueProposition  String @db.Text
  dealSplit         Json // {"wells": 30, "partner": 70}
  outreachStrategy  String @default("email-sequence") // "email-sequence", "linkedin", "cold-call"

  // Status
  status PlaybookStatus @default(DRAFT)

  // Created by
  createdBy String // Clerk user ID

  // Target accounts
  targetAccounts TargetAccount[]

  // Email sequence
  emailSequence EmailSequence?

  // Metrics
  totalTargets   Int @default(0)
  contacted      Int @default(0)
  responded      Int @default(0)
  meetingsBooked Int @default(0)
  dealsWon       Int @default(0)
  totalRevenue   BigInt @default(0)

  @@index([partnerId])
  @@index([status])
  @@index([createdBy])
}

// Target account for co-sell
model TargetAccount {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Playbook link
  playbookId String
  playbook   CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  // Company info
  companyName       String
  industry          String?
  revenue           String? // "$10M-50M", "$50M-100M", etc.
  employeeCount     String? // "50-200", "200-500", etc.

  // Pain point & solution
  painPoint         String @db.Text
  solution          String @db.Text
  estimatedDealSize Int @default(500000) // in cents

  // Contact info
  contactName  String?
  contactEmail String?
  contactTitle String?
  contactPhone String?
  linkedinUrl  String?

  // Outreach tracking
  outreachSequence Json? // Track which emails have been sent
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?

  // Deal tracking
  dealStage        DealStage @default(PROSPECTING)
  dealValue        Int? // Actual deal value if won
  wonAt            DateTime?
  lostAt           DateTime?
  lostReason       String?

  // Notes
  notes String? @db.Text

  @@index([playbookId])
  @@index([dealStage])
  @@index([nextFollowUpAt])
}

// Email sequence template
model EmailSequence {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Playbook link
  playbookId String @unique
  playbook   CoSellPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  // Sequence definition (JSON array of email templates)
  sequence Json // [{day: 0, subject: "...", body: "...", type: "INTRO"}, ...]

  @@index([playbookId])
}

// ============================================
// GRAIN & VAULT ESCROW TRANSACTIONS
// Powers $3T transaction volume
// ============================================

enum EscrowStatus {
  PENDING         // Awaiting deposit
  ACTIVE          // Funds escrowed, milestones in progress
  MILESTONE_1     // First milestone completed
  MILESTONE_2     // Second milestone completed
  COMPLETED       // All milestones done, funds released
  DISPUTED        // Dispute raised
  CANCELLED       // Escrow cancelled
  EXPIRED         // Expired without completion
}

// Blockchain escrow transaction
model GrainEscrow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // On-chain reference
  escrowId         String @unique // On-chain escrow ID
  chainId          Int // 8453 for Base, etc.
  contractAddress  String // Smart contract address
  transactionHash  String? // Creation transaction hash

  // Parties
  depositor    String // Wallet address or Clerk user ID
  beneficiary  String // Wallet address or Clerk user ID
  arbitrator   String? // Wallet address for dispute resolution

  // Amount (in USDC/GRAIN, 6 decimals)
  totalAmount     BigInt
  releasedAmount  BigInt @default(0)

  // Status
  status EscrowStatus @default(PENDING)

  // Milestones (JSON array)
  milestones Json // [{description: "...", percentage: 50, completed: false}, ...]

  // Timestamps
  depositedAt   DateTime?
  firstReleaseAt DateTime?
  completedAt   DateTime?
  disputedAt    DateTime?

  // Deal metadata
  dealId          String? // External reference (e.g., "DR-$3B-2025")
  dealDescription String? @db.Text

  // Fees
  escrowFeePercent Float @default(0.5) // 0.5% escrow service fee
  escrowFee        BigInt? // Calculated fee in cents

  @@index([escrowId])
  @@index([depositor])
  @@index([beneficiary])
  @@index([status])
  @@index([createdAt])
}

// Partner referral tracking - when Wells recommends a partner service to a user
model PartnerReferral {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User who received the recommendation
  userId String // Clerk user ID

  // Partner being recommended
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Referral tracking
  referralUrl String // The tracked URL that was shared with the user
  context     String @db.Text // What triggered the recommendation (e.g., "User asked about payment processing")

  // Interaction tracking
  clickedAt   DateTime? // When user clicked the referral link
  convertedAt DateTime? // When user completed sign-up/purchase

  // Revenue tracking
  conversionValue BigInt? // Value of the conversion in cents
  commissionEarned BigInt? // Commission earned by Wells Onyx in cents

  // Status
  status String @default("pending") // "pending", "clicked", "converted", "expired"

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// SELLER PROFILES & MARKETPLACE SUPPLY
// Two-sided marketplace: Buyers request, Sellers fulfill
// ============================================

enum PricingModel {
  FIXED             // Fixed price per unit
  VOLUME_DISCOUNT   // Volume-based pricing tiers
  NEGOTIABLE        // Case-by-case negotiation
  RFQ_ONLY          // Must request quote with specs
}

enum NotificationFrequency {
  INSTANT         // Real-time notifications
  DAILY_DIGEST    // Once per day summary
  WEEKLY_DIGEST   // Once per week summary
}

// Seller profile - suppliers on the platform
model SellerProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // User reference
  userId String @unique // Clerk user ID

  // Company info
  companyName String
  contactName String
  email       String
  phone       String?

  // What they sell
  categories String[] // e.g., ['Electronics', 'PCB Manufacturing']
  products   String[] // e.g., ['STM32 Microcontrollers', 'Custom PCBs']
  services   String[] // e.g., ['PCB Design', 'Prototyping']

  // Capabilities
  minimumOrderQuantity Int?
  maximumOrderQuantity Int?
  leadTimeDays         Int? // Typical lead time in days
  shippingRegions      String[] // e.g., ['North America', 'Global']

  // Business details
  yearsInBusiness Int?
  certifications  String[] // e.g., ['ISO 9001', 'RoHS', 'UL']
  website         String?

  // Pricing
  pricingModel      PricingModel @default(NEGOTIABLE)
  typicalPriceRange String? // e.g., '$1-10 per unit'

  // Notification preferences
  notificationChannels  String[] // ['email', 'sms']
  notificationFrequency NotificationFrequency @default(INSTANT)

  // Status
  verified      Boolean @default(false)
  active        Boolean @default(true)
  rating        Float? // 1-5 stars
  completedDeals Int    @default(0)

  // Onboarding state (JSON serialized partial profile data)
  onboardingState     Json?
  onboardingCompleted Boolean @default(false)

  // Quotes sent by this seller
  quotes SellerQuote[]

  @@index([userId])
  @@index([active])
  @@index([verified])
  @@index([categories])
}

// Seller quote in response to an RFQ
model SellerQuote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Seller reference
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // RFQ reference
  rfqId String
  rfq   RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  // Quote details
  pricePerUnit    Int // in cents
  totalPrice      Int // in cents
  quantity        Int
  leadTimeDays    Int
  validUntil      DateTime

  // Additional details
  notes           String? @db.Text
  terms           String? @db.Text
  specifications  Json? // Detailed specs and compliance info

  // Status
  status String @default("pending") // "pending", "accepted", "rejected", "expired"

  // If accepted
  acceptedAt DateTime?
  acceptedBy String? // Buyer user ID

  @@index([sellerId])
  @@index([rfqId])
  @@index([status])
  @@index([createdAt])
}
