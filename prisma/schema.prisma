  @@index([connection_id], map: "idx_sync_log_connection_id")
  @@index([status, started_at], map: "idx_sync_log_status")
  @@index([user_id], map: "idx_sync_log_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model calendar_webhooks {
  id                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_id             String                    @db.Uuid
  provider                  String
  webhook_id                String
  resource_uri              String
  expiration                DateTime                  @db.Timestamptz(6)
