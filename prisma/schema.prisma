  timezone             String?   @default("America/Los_Angeles")
  buffer_before        Int?      @default(0)
  buffer_after         Int?      @default(0)
  min_meeting_duration Int?      @default(15)
  max_meetings_per_day Int?      @default(10)
  auto_accept_invites  Boolean?  @default(false)
  auto_accept_domains  String[]
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_availability_user_id")
}

