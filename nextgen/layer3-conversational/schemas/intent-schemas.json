{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conversational ERP Intent Schemas",
  "description": "JSON schemas for intent detection and entity extraction in conversational ERP",
  "definitions": {
    "ConversationalRequest": {
      "type": "object",
      "required": ["message", "accountId"],
      "properties": {
        "message": {
          "type": "string",
          "description": "User's natural language input"
        },
        "sessionId": {
          "type": "string",
          "description": "Conversation session identifier"
        },
        "accountId": {
          "type": "string",
          "description": "Grain & Vault account ID"
        },
        "userId": {
          "type": "string",
          "description": "User identifier for authorization"
        },
        "context": {
          "$ref": "#/definitions/ConversationContext"
        }
      }
    },
    "ConversationalResponse": {
      "type": "object",
      "required": ["message", "sessionId", "state"],
      "properties": {
        "message": {
          "type": "string",
          "description": "Assistant's response"
        },
        "sessionId": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["idle", "gathering_info", "confirming", "processing", "awaiting_authorization", "completed", "error"]
        },
        "intent": {
          "type": "string",
          "enum": [
            "create_vendor", "update_vendor", "search_vendor", "get_vendor_details",
            "create_po", "update_po", "approve_po", "search_po", "get_po_status",
            "create_invoice", "approve_invoice", "dispute_invoice", "search_invoices", "get_invoice_status", "get_overdue_invoices",
            "create_payment", "authorize_payment", "schedule_payment", "cancel_payment", "get_payment_status",
            "get_balance", "get_ledger_summary", "get_trial_balance", "get_float_balance", "get_yield_summary",
            "create_escrow", "release_escrow", "get_escrow_status",
            "get_summary", "unknown"
          ]
        },
        "intentConfidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "entities": {
          "$ref": "#/definitions/ExtractedEntities"
        },
        "missingFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggestedActions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "intent": { "type": "string" },
              "entities": { "type": "object" }
            }
          }
        },
        "actionResult": {
          "$ref": "#/definitions/ActionResult"
        },
        "pendingAction": {
          "$ref": "#/definitions/PendingAction"
        },
        "quickReplies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ConversationContext": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "accountId": { "type": "string" },
        "userId": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["idle", "gathering_info", "confirming", "processing", "awaiting_authorization", "completed", "error"]
        },
        "currentIntent": { "type": "string" },
        "intentConfidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "entities": {
          "$ref": "#/definitions/ExtractedEntities"
        },
        "missingFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pendingAction": {
          "$ref": "#/definitions/PendingAction"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "lastActivityAt": { "type": "string", "format": "date-time" }
      }
    },
    "ExtractedEntities": {
      "type": "object",
      "description": "Entities extracted from user input",
      "properties": {
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "vendorCode": { "type": "string" },
        "poNumber": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "paymentNumber": { "type": "string" },
        "escrowCode": { "type": "string" },
        "amount": { "type": "number" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "date": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "deliveryDate": { "type": "string", "format": "date" },
        "scheduledDate": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string" },
        "paymentMethod": {
          "type": "string",
          "enum": ["grain", "ach", "wire", "check", "virtual_card"]
        },
        "paymentTerms": { "type": "string" },
        "lineItems": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "quantity", "unitPrice"],
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "accountCode": { "type": "string" }
            }
          }
        },
        "costCenter": { "type": "string" },
        "department": { "type": "string" },
        "project": { "type": "string" },
        "notes": { "type": "string" },
        "memo": { "type": "string" }
      }
    },
    "ActionResult": {
      "type": "object",
      "required": ["success", "action", "message"],
      "properties": {
        "success": { "type": "boolean" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "resourceId": { "type": "string" },
        "message": { "type": "string" },
        "data": { "type": "object" },
        "error": { "type": "string" },
        "nextSteps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "PendingAction": {
      "type": "object",
      "required": ["type", "resource", "data", "requiresAuthorization", "expiresAt"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["create", "update", "approve", "authorize", "delete"]
        },
        "resource": {
          "type": "string",
          "enum": ["vendor", "purchase_order", "invoice", "payment", "escrow"]
        },
        "data": { "type": "object" },
        "requiresAuthorization": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "IntentClassification": {
      "type": "object",
      "description": "Result of intent classification",
      "required": ["intent", "confidence", "entities"],
      "properties": {
        "intent": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "entities": { "$ref": "#/definitions/ExtractedEntities" },
        "alternativeIntents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intent": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
